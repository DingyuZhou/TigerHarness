# Slack bridge lane environment (a team's configs/.env)
# Get the tokens from https://api.slack.com/apps -> your app.
# The bridge always runs from a slack-bridge.yaml lanes index
# (TIGERHARNESS_BRIDGES_CONFIG); each lane's fragment points at an env
# file like this one (default: <team>/configs/.env). See
# docs/slack-bridge.md.

# Socket Mode app-level token (xapp-...)
SLACK_APP_TOKEN=xapp-1-REPLACE-ME

# Bot user OAuth token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# Comma-separated list of allowed Slack user IDs (canonical spelling).
# Used when the lane fragment omits `allowed_user_ids`; the notify CLI
# reads it too. Find yours at https://api.slack.com/methods/users.identity
SLACK_ALLOWED_USER_IDS=U0123ABC

# Optional: tiger-memory CLI for this lane
# TIGER_MEMORY_CLI=tiger-memory

# ---- Team knobs (this file is the Operator-owned surface; the journal
# ---- and autodrive read these keys from here, no code or unit edits) ----

# Let Slack-triggered sessions DRIVE the journal (ADR 0013). Off by
# default: then a Slack session may schedule (`journal defer`) but never
# claim. `1` lets it `journal claim` without --allow-api-drive.
# TIGERHARNESS_JOURNAL_SLACK_DRIVES=1

# Self-driving journal (ADR 0010): scheduling starts the autodrive daemon,
# a drained queue stops it. Off by default. See docs/autodrive.md.
# TIGERHARNESS_AUTODRIVE_AUTOSTART=1
# TIGERHARNESS_AUTODRIVE_INTERVAL=600        # seconds between fires (floor 60)
# TIGERHARNESS_AUTODRIVE_MAX_BUDGET=5        # USD cap per drive (unset = uncapped)
# TIGERHARNESS_AUTODRIVE_DRIVER=chief        # --driver persona for daemon drives
# TIGERHARNESS_AUTODRIVE_NOTIFY=1            # Slack heartbeats + drive summaries
# TIGERHARNESS_AUTODRIVE_NOTIFY_CHANNEL=dm   # a channel id, or `dm` for the operator DM

# Ops-log channel for proactive notifies, turn-progress heartbeats and
# autodrive notices (invite the bot to it first).
# SLACK_NOTIFY_CHANNEL=C0123ABC
