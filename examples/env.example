# Slack bridge configuration
# Get these from https://api.slack.com/apps -> your app

# Socket Mode app-level token (xapp-...)
SLACK_APP_TOKEN=xapp-1-REPLACE-ME

# Bot user OAuth token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# Comma-separated list of allowed Slack user IDs
# Find yours at https://api.slack.com/methods/users.identity
ALLOWED_SLACK_USER_IDS=U0123ABC

# Agent configuration
# Persona prompts use the nested layout: personas/<name>/prompt.md
TIGERHARNESS_PERSONAS_DIR=./personas
TIGERHARNESS_AGENT_PROMPT=./personas/researcher/prompt.md
TIGERHARNESS_AGENT_CWD=.

# Optional: tiger-memory integration
# TIGER_MEMORY_CONFIG=./tiger-memory.config.yaml
# TIGER_MEMORY_CLI=tiger-memory
